[Unit]
Description=Yani CRM telegram worker
After=network.target yani-app.service
PartOf=yani-app.service

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/yani
Environment=NODE_ENV=production
EnvironmentFile=-/var/www/yani/.env
ExecStart=/usr/bin/node crm-workers/crm-telegram-worker.js
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=20
StandardOutput=append:/var/log/yani-crm-telegram.log
StandardError=append:/var/log/yani-crm-telegram.log

[Install]
WantedBy=multi-user.target
