# Database
DATABASE_URL=postgresql://yani:yani@localhost:5433/yani?schema=public

# Redis (optional for MVP scheduler — used when REDIS_URL is set)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-long-random-secret-in-production
ADMIN_EMAIL=admin@yani.local
ADMIN_PASSWORD=admin123456

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880

# Rate limiting
DEFAULT_RATE_LIMIT=60
