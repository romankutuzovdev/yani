# Database (SQLite file — no Postgres/Docker required)
DATABASE_URL="file:./data/yani.db"

# Redis optional (not used by MVP)
# REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-long-random-secret-in-production
ADMIN_EMAIL=admin@yani.local
ADMIN_PASSWORD=admin123456

# LLM — active provider: vibecode | hoster | deepseek | openai
# Admin can also switch in Настройки (writes prisma/data/llm-settings.json).
LLM_PROVIDER=vibecode

# vibecode.moe (OpenAI-compatible): https://vibecode.moe/setup/sdk
VIBECODE_API_KEY=
VIBECODE_BASE_URL=https://vibecode.moe/v1
VIBECODE_MODEL=gpt-5.5

# hoster.by AI (OpenAI-compatible): https://ai.hoster.by/v1
# HOSTER_API_KEY=
# HOSTER_BASE_URL=https://ai.hoster.by/v1
# HOSTER_MODEL=qwen3.8-27b

# Optional fallback / legacy DeepSeek
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Yandex Cloud Search API (агент: web_search / web_research / CRM при указании в промпте навыка)
# Создайте сервисный аккаунт + API-ключ со scope yc.search-api.execute и укажите folder id.
# https://yandex.cloud/ru/docs/search-api/quickstart
# YANDEX_SEARCH_API_KEY=
# YANDEX_FOLDER_ID=

# Instagram Direct (Meta). Токен аккаунта хранится в навыке, не здесь.
# INSTAGRAM_APP_SECRET= секрет приложения Meta, чтобы проверять подпись вебхука
# INSTAGRAM_WEBHOOK_VERIFY_TOKEN= строка, которую вы вставляете в Meta при подписке вебхука
# Если verify token не задан, Yani покажет свой в настройках навыка.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880
MAX_UPLOAD_VIDEO_BYTES=52428800

# Rate limiting
DEFAULT_RATE_LIMIT=60

# Parallel chats on one Node process (shared host ~100 simultaneous)
CHAT_CONCURRENCY=100
CHAT_QUEUE_MAX=250
