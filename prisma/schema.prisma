generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
  API_CLIENT
  ORG
}

enum AgentStatus {
  OFFLINE
  ONLINE
  IDLE
  THINKING
  WORKING
  WAITING
  SUCCESS
  ERROR
}

enum CharacterState {
  IDLE
  THINKING
  WORKING
  SUCCESS
  ERROR
  SPEAKING
  WAITING
  SAD
  ANGRY
}

enum AssetType {
  IMAGE
  GIF
  WEBP
  LOTTIE
  VIDEO
  SPRITE
}

enum TaskStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum MemoryType {
  SHORT_TERM
  LONG_TERM
  TASK
  USER
  AGENT
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(USER)
  /** Organization cabinet: the one agent this login may edit. */
  orgAgentId   String?
  /** Shown in the organization cabinet. Filled when access is issued. */
  orgName      String    @default("")
  orgUnp       String    @default("")
  /** Tariff the admin typed for this organization. Empty name means no tariff. */
  planName         String @default("")
  planMonthlyPrice Float  @default(0)
  /** CRM / sales cabinet for this organization agent. */
  salesEnabled           Boolean @default(false)
  salesPlanName          String  @default("")
  salesPlanMonthlyPrice  Float   @default(0)
  /** Max sales playbooks (менеджеры/навыки продаж). 0 = без лимита, если salesEnabled. */
  salesPlaybookLimit     Int     @default(0)
  /** Contract limit: how many agents may use sales CRM under this org. */
  salesAgentLimit        Int     @default(1)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  agents       Agent[]
  orgAgent     Agent?    @relation("OrgCabinet", fields: [orgAgentId], references: [id], onDelete: SetNull)
  apiKeys      ApiKey[]
  memories     Memory[]  @relation("UserMemories")
  logs         SystemLog[]
}

model Agent {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  description    String        @default("")
  logoUrl        String        @default("")
  /** Square icon used when the chat is installed on a phone home screen. */
  homeIconUrl    String        @default("")
  greeting       String        @default("")
  /** Optional caption shown beside the character in the public chat. */
  asideText      String        @default("")
  personality    String        @default("friendly")
  role           String        @default("AI assistant")
  communicationStyle String    @default("clear and helpful")
  rules          String        @default("")
  goals          String        @default("")
  restrictions   String        @default("")
  additionalInstructions String @default("")
  systemPrompt   String        @default("")
  model          String        @default("deepseek-chat")
  temperature    Float         @default(0.7)
  maxIterations  Int           @default(10)
  maxTokens      Int           @default(4096)
  timeoutMs      Int           @default(120000)
  /** 0 — без лимита */
  dailyRequestLimit   Int      @default(0)
  monthlyRequestLimit Int      @default(0)
  requestCountDay     Int      @default(0)
  requestCountDayKey  String   @default("")
  requestCountMonth   Int      @default(0)
  requestCountMonthKey String  @default("")
  status         AgentStatus   @default(IDLE)
  statusMessage  String        @default("")
  enabled        Boolean       @default(true)
  /** Chat and sales replies may search Yandex and open public pages. */
  webSearchEnabled Boolean     @default(false)
  /** Opens yani.by and /chat when the URL has no slug. Only one agent at a time. */
  isPrimary      Boolean       @default(false)
  ownerId        String
  characterId    String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  owner      User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  character  AgentCharacter? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  skills     AgentSkill[]
  tools      AgentTool[]
  tasks      Task[]
  memories   Memory[]
  apiKeys    ApiKey[]
  widgets    Widget[]
  usage      UsageRecord[]
  logs       SystemLog[]
  chats      ChatMessage[]
  salesPlaybooks SalesPlaybook[]
  orgUsers   User[]        @relation("OrgCabinet")
  ipBlocks   AgentIpBlock[]
  docs       AgentDoc[]

  @@index([ownerId])
  @@index([status])
}

model AgentCharacter {
  id           String         @id @default(cuid())
  name         String
  description  String         @default("")
  defaultState CharacterState @default(IDLE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  assets       CharacterAsset[]
  agent        Agent?
}

model CharacterAsset {
  id          String         @id @default(cuid())
  characterId String
  state       CharacterState
  type        AssetType      @default(IMAGE)
  url         String
  mimeType    String
  filename    String
  sizeBytes   Int            @default(0)
  createdAt   DateTime       @default(now())

  character AgentCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, state])
  @@index([characterId])
}

model Skill {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String
  iconUrl      String   @default("")
  systemPrompt String   @default("")
  /** Legacy / aggregate: first file URL or empty */
  documentUrl  String   @default("")
  /** Aggregate label for UI and prompts, e.g. "3 файла" or names */
  documentName String   @default("")
  /** Concatenated text from SkillDocument rows — injected into the agent prompt */
  documentText String   @default("")
  model        String   @default("")
  tools        String   @default("[]")
  enabled      Boolean  @default(true)
  sortOrder    Int      @default(0)
  config       String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  agents       AgentSkill[]
  documents    SkillDocument[]

  @@index([sortOrder])
}

/** One attached source file for a skill (Word / txt / md). Max 15 per skill. */
model SkillDocument {
  id        String   @id @default(cuid())
  skillId   String
  fileName  String
  url       String   @default("")
  mimeType  String   @default("text/plain")
  text      String   @default("")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId, sortOrder])
}

model AgentDoc {
  id        String   @id @default(cuid())
  agentId   String
  title     String
  fileName  String
  url       String   @default("")
  mimeType  String   @default("text/plain")
  /** preview — текст в окне чата, direct — файл сразу в новой вкладке */
  openMode  String   @default("preview")
  text      String   @default("")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, sortOrder])
}

model AgentSkill {
  agentId   String
  skillId   String
  enabled   Boolean @default(true)
  visible   Boolean @default(true)
  sortOrder Int     @default(0)

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([agentId, skillId])
  @@index([agentId, sortOrder])
}

model ToolRegistry {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  inputSchema String @default("{}")
  enabled     Boolean  @default(true)
  config      String @default("{}")
  builtIn     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  agents      AgentTool[]
}

model AgentTool {
  agentId String
  toolId  String
  enabled Boolean @default(true)
  config  String @default("{}")

  agent Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tool  ToolRegistry @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@id([agentId, toolId])
}

model Task {
  id             String     @id @default(cuid())
  agentId        String
  title          String
  description    String     @default("")
  instruction    String
  priority       Int        @default(0)
  status         TaskStatus @default(PENDING)
  scheduledAt    DateTime?
  cronExpression String?
  maxDurationMs  Int        @default(120000)
  maxIterations  Int        @default(10)
  skillIds       String @default("[]")
  toolNames      String @default("[]")
  result         String?
  error          String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  agent      Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  executions TaskExecution[]
  memories   Memory[]
  logs       SystemLog[]

  @@index([agentId, status])
  @@index([scheduledAt])
}

model TaskExecution {
  id         String     @id @default(cuid())
  taskId     String
  status     TaskStatus @default(RUNNING)
  summary    String     @default("")
  result     String?
  error      String?
  iterations Int        @default(0)
  startedAt  DateTime   @default(now())
  finishedAt DateTime?
  cancelled  Boolean    @default(false)

  task   Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  events ExecutionEvent[]

  @@index([taskId])
}

model ExecutionEvent {
  id          String   @id @default(cuid())
  executionId String
  type        String
  summary     String
  data        String @default("{}")
  createdAt   DateTime @default(now())

  execution TaskExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, createdAt])
}

model Memory {
  id        String     @id @default(cuid())
  agentId   String
  userId    String?
  taskId    String?
  type      MemoryType @default(SHORT_TERM)
  content   String
  metadata  String @default("{}")
  createdAt DateTime   @default(now())

  agent Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user  User?  @relation("UserMemories", fields: [userId], references: [id], onDelete: SetNull)
  task  Task?  @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([agentId, type, createdAt])
  @@index([agentId, userId])
}

model VisitorRequest {
  id        String   @id @default(cuid())
  ip        String
  agentId   String   @default("")
  agentName String   @default("")
  sessionId String   @default("")
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([ip, createdAt])
  @@index([agentId, createdAt])
}

/** IP closed for one agent by its organization. Admin and bot blocks stay global. */
model AgentIpBlock {
  id        String   @id @default(cuid())
  agentId   String
  ip        String
  reason    String   @default("")
  createdAt DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, ip])
  @@index([agentId])
}

model IpBlock {
  ip           String    @id
  reason       String    @default("")
  /** manual — until an admin lifts it; bot — until blockedUntil */
  source       String    @default("manual")
  blockedUntil DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ChatMessage {
  id        String   @id @default(cuid())
  agentId   String
  sessionId String
  role      String
  content   String
  metadata  String @default("{}")
  createdAt DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, sessionId, createdAt])
}

/** One isolated sales workspace: product, prompt, pipeline and its client base. */
model SalesPlaybook {
  id                 String   @id @default(cuid())
  agentId            String
  name               String
  product            String   @default("")
  systemPrompt       String   @default("")
  goals              String   @default("")
  communicationStyle String   @default("")
  restrictions       String   @default("")
  qualificationQuestions String @default("")
  status             String   @default("STOPPED")
  sendMode           String   @default("APPROVAL_REQUIRED")
  /** Which channels are used for client communication (can be both). */
  channelTelegramEnabled Boolean @default(true)
  channelEmailEnabled    Boolean @default(true)
  /** Min seconds between outbound Telegram sends for this playbook. */
  telegramSendIntervalSeconds Int @default(300)
  replyCount         Int      @default(0)
  replySpendUsd      Float    @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  agent     Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  documents SalesDocument[]
  channelConnections CrmChannelConnection[]
  leads     SalesLead[]
  identities LeadIdentity[]
  importJobs CrmImportJob[]
  campaigns  CrmCampaign[]
  contactLists CrmContactList[]
  auditEvents CrmAuditEvent[]
  deadLetters CrmDeadLetter[]

  @@unique([agentId, name])
  @@index([agentId, status])
}

/** Named outbound contact list (EMAIL or TELEGRAM) for first-touch campaigns. */
model CrmContactList {
  id         String   @id @default(cuid())
  playbookId String
  name       String
  /** EMAIL | TELEGRAM */
  channel    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  playbook SalesPlaybook       @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  contacts CrmContactListItem[]

  @@index([playbookId, channel, updatedAt])
  @@unique([playbookId, name, channel])
}

model CrmContactListItem {
  id          String   @id @default(cuid())
  listId      String
  displayName String   @default("")
  company     String   @default("")
  email       String   @default("")
  phone       String   @default("")
  telegram    String   @default("")
  notes       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  list CrmContactList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([listId, updatedAt])
  @@index([listId, email])
  @@index([listId, telegram])
}

/** Source material used to ground CRM replies and proposals. */
model SalesDocument {
  id          String   @id @default(cuid())
  playbookId  String
  fileName    String
  url         String
  mimeType    String
  text        String   @default("")
  sizeBytes   Int      @default(0)
  status      String   @default("READY")
  error       String   @default("")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  playbook SalesPlaybook @relation(fields: [playbookId], references: [id], onDelete: Cascade)

  @@index([playbookId, sortOrder])
}

/** Potential client inside exactly one sales playbook. */
model SalesLead {
  id               String   @id @default(cuid())
  playbookId       String
  displayName      String   @default("")
  company          String   @default("")
  email            String   @default("")
  phone            String   @default("")
  telegram         String   @default("")
  stage            String   @default("NEW")
  notes            String   @default("")
  agentInstruction String   @default("")
  agentPaused      Boolean  @default(false)
  /** When set, manager should call/write the client ASAP. */
  urgentAt         DateTime?
  urgentNote       String   @default("")
  replyCount       Int      @default(0)
  replySpendUsd    Float    @default(0)
  lastContactAt    DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  playbook     SalesPlaybook   @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  identities   LeadIdentity[]
  conversations CrmConversation[]
  fieldChanges LeadFieldChange[]
  campaignItems CrmCampaignItem[]

  @@index([playbookId, stage, updatedAt])
  @@index([playbookId, lastContactAt])
}

/** Normalized contact key used to prevent duplicates inside one playbook. */
model LeadIdentity {
  id           String   @id @default(cuid())
  playbookId   String
  leadId       String
  type         String
  value        String
  originalValue String  @default("")
  createdAt    DateTime @default(now())

  playbook SalesPlaybook @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  lead     SalesLead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([playbookId, type, value])
  @@index([leadId])
}

/** Audit log for automatic or manual CRM field updates. */
model LeadFieldChange {
  id         String   @id @default(cuid())
  leadId     String
  field      String
  oldValue   String   @default("")
  newValue   String
  source     String   @default("AUTO")
  confidence Float    @default(1)
  evidence   String   @default("")
  createdAt  DateTime @default(now())

  lead SalesLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

/** Persistent CRM thread. External channels will attach to it in later phases. */
model CrmConversation {
  id               String   @id @default(cuid())
  leadId           String
  channel          String   @default("MANUAL")
  externalThreadId String   @default("")
  externalContext  String   @default("{}")
  lastMessageAt    DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  lead     SalesLead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  messages CrmMessage[]
  outbox   CrmOutboxMessage[]

  @@unique([leadId, channel])
  @@index([leadId, lastMessageAt])
}

/** A single inbound, outbound or draft item in a CRM conversation. */
model CrmMessage {
  id             String   @id @default(cuid())
  conversationId String
  direction      String
  status         String   @default("RECORDED")
  body           String
  attachments    String   @default("[]")
  externalId     String   @default("")
  createdAt      DateTime @default(now())

  conversation CrmConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  outbox       CrmOutboxMessage?

  @@index([conversationId, createdAt])
  @@index([direction, status])
}

/** Encrypted external channel credentials and polling state for one playbook. */
model CrmChannelConnection {
  id              String   @id @default(cuid())
  playbookId      String
  type            String
  status          String   @default("CONNECTED")
  config          String   @default("{}")
  encryptedSecret String
  lastError       String   @default("")
  lastPolledAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  playbook     SalesPlaybook   @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  inboundEvents CrmInboundEvent[]
  outboxMessages CrmOutboxMessage[]

  @@unique([playbookId, type])
  @@index([type, status])
}

/** Idempotent copy of an update received from an external channel. */
model CrmInboundEvent {
  id           String   @id @default(cuid())
  connectionId String
  externalId   String
  payload      String
  status       String   @default("RECEIVED")
  error        String   @default("")
  createdAt    DateTime @default(now())
  processedAt  DateTime?

  connection CrmChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalId])
  @@index([connectionId, status, createdAt])
}

/** Persistent delivery queue. Only APPROVED rows may be sent by a worker. */
model CrmOutboxMessage {
  id             String   @id @default(cuid())
  connectionId   String
  conversationId String
  messageId      String   @unique
  status         String   @default("DRAFT")
  body           String
  attempts       Int      @default(0)
  maxAttempts    Int      @default(5)
  nextAttemptAt  DateTime @default(now())
  externalId     String   @default("")
  error          String   @default("")
  approvedAt     DateTime?
  sentAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  connection   CrmChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  conversation CrmConversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      CrmMessage           @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([connectionId, status, nextAttemptAt])
  @@index([conversationId, createdAt])
}

/** Batch import of contacts into a sales playbook. */
model CrmImportJob {
  id              String   @id @default(cuid())
  playbookId      String
  fileName        String
  status          String   @default("PREVIEW")
  totalRows       Int      @default(0)
  validRows       Int      @default(0)
  createdCount    Int      @default(0)
  duplicateCount  Int      @default(0)
  skippedCount    Int      @default(0)
  reportJson      String   @default("{}")
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  playbook SalesPlaybook @relation(fields: [playbookId], references: [id], onDelete: Cascade)

  @@index([playbookId, createdAt])
}

/** Mass first-touch campaign (email MVP). */
model CrmCampaign {
  id               String   @id @default(cuid())
  playbookId       String
  name             String
  channel          String   @default("EMAIL")
  status           String   @default("DRAFT")
  subject          String   @default("")
  /** TEMPLATE = готовый текст с {{placeholders}}; PROMPT = инструкция, текст пишет агент. */
  bodyMode         String   @default("TEMPLATE")
  bodyTemplate     String   @default("")
  dailyLimit       Int      @default(40)
  intervalSeconds  Int      @default(90)
  quietHoursStart  Int?
  quietHoursEnd    Int?
  timezone         String   @default("Europe/Minsk")
  sentToday        Int      @default(0)
  sentTodayDate    String   @default("")
  importJobId      String   @default("")
  /** JSON string[] of CrmContactList ids — new contacts sync into a running campaign. */
  contactListIds   String   @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  startedAt        DateTime?
  stoppedAt        DateTime?

  playbook SalesPlaybook   @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  items    CrmCampaignItem[]

  @@index([playbookId, status, updatedAt])
  @@index([status, updatedAt])
}

model CrmCampaignItem {
  id             String   @id @default(cuid())
  campaignId     String
  leadId         String
  status         String   @default("PENDING")
  scheduledAt    DateTime @default(now())
  outboxId       String   @default("")
  error          String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  processedAt    DateTime?

  campaign CrmCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead     SalesLead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([campaignId, leadId])
  @@index([campaignId, status, scheduledAt])
  @@index([status, scheduledAt])
}

/** Immutable CRM audit trail for managers and operators. */
model CrmAuditEvent {
  id         String   @id @default(cuid())
  playbookId String?
  agentId    String?
  userId     String?
  action     String
  entityType String   @default("")
  entityId   String   @default("")
  summary    String
  meta       String   @default("{}")
  createdAt  DateTime @default(now())

  playbook SalesPlaybook? @relation(fields: [playbookId], references: [id], onDelete: SetNull)

  @@index([playbookId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
}

/** Permanently failed deliveries moved out of the hot outbox. */
model CrmDeadLetter {
  id           String   @id @default(cuid())
  playbookId   String
  connectionId String   @default("")
  outboxId     String   @default("")
  messageId    String   @default("")
  channel      String   @default("")
  body         String   @default("")
  error        String   @default("")
  attempts     Int      @default(0)
  payload      String   @default("{}")
  createdAt    DateTime @default(now())
  resolvedAt   DateTime?

  playbook SalesPlaybook @relation(fields: [playbookId], references: [id], onDelete: Cascade)

  @@index([playbookId, createdAt])
  @@index([resolvedAt, createdAt])
}

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  keyHash    String
  keyPrefix  String
  scopes     String    @default("[\"chat\",\"tasks\",\"status\"]")
  rateLimit  Int       @default(60)
  userId     String
  agentId    String?
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([keyPrefix])
  @@index([userId])
}

model Widget {
  id        String   @id @default(cuid())
  agentId   String
  name      String   @default("Default Widget")
  enabled   Boolean  @default(true)
  config    String @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
}

model UsageRecord {
  id           String   @id @default(cuid())
  agentId      String?
  provider     String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  totalTokens  Int      @default(0)
  estimatedCost Float   @default(0)
  requestType  String   @default("chat")
  createdAt    DateTime @default(now())

  agent Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([agentId, createdAt])
  @@index([createdAt])
}

model SystemLog {
  id        String   @id @default(cuid())
  level     LogLevel @default(INFO)
  type      String
  message   String
  agentId   String?
  taskId    String?
  userId    String?
  meta      String @default("{}")
  createdAt DateTime @default(now())

  agent Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  task  Task?  @relation(fields: [taskId], references: [id], onDelete: SetNull)
  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([level, createdAt])
  @@index([agentId, createdAt])
  @@index([type, createdAt])
}
